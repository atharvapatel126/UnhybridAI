# Copy to .env locally; leave the key blank for local-only functionality.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite
CURRENT_TERM=2026-FALL
TOP_K=5
SIM_THRESHOLD=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=80
UPLOAD_LIMIT_MB=20
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=1
LOG_MAX_BYTES=5000000
LOG_BACKUPS=3
# Optional paths: DATA_DIR, DB_PATH, CHROMA_DIR, RAW_DOCS_DIR, LOGS_DIR, MODEL_CACHE
